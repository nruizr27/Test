    RowBox[{"2", " ", "x", " ", 
     RowBox[{"kp", "[", "x", "]"}], " ", 
     RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], "+", 
    RowBox[{"2", " ", "x", " ", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "x", " ", 
        RowBox[{"kp", "[", "x", "]"}], " ", 
        RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], "+", 
       RowBox[{"2", " ", "x", " ", 
        RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}]}], "==", "0"}], ",", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Correct", " ", "equation", " ", "for", " ", 
     RowBox[{
      RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}], ".", " ", "note"}], " ", 
