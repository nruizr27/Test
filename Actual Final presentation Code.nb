    RowBox[{
     RowBox[{
     "then", " ", "finding", " ", "the", " ", "roots", " ", "in", " ", "the", 
      " ", "quartic", " ", "polynomial", " ", "being", " ", "integrated", " ",
       "in", " ", "the", " ", "lapse", " ", "equation", " ", "that", " ", 
      RowBox[{"coincide", ".", " ", "Finding"}], " ", 
      RowBox[{"where", "/", "conditions"}], " ", "for", " ", "the", " ", 
      "roots", " ", "to", " ", "coincide", " ", "and", " ", "then", " ", 
