     " ", "vector", " ", "was", " ", "changed", " ", "from"}], " ", "-", " ", 
    "to", " ", "+", " ", 
    RowBox[{
    "to", " ", "be", " ", "consistent", " ", "with", " ", "conventions", " ", 
     "in", " ", "the", " ", "\"\<Maximally Slicing a Black Hole\>\"", " ", 
