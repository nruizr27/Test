Cell[BoxData[{
 RowBox[{
  RowBox[{"NewHammC", ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["T", "2"], " ", 
        RowBox[{"ep", "[", "x", "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["x", "2"], ")"}], 
        RowBox[{"3", "/", "2"}]]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["T", "2"], 
           SuperscriptBox["x", "4"]]}], ")"}], " ", 
        RowBox[{"ep", "[", "x", "]"}]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         SuperscriptBox["x", "2"]]}]], "+", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SqrtBox[
           SuperscriptBox["x", "2"]], 
          RowBox[{"ep", "[", "x", "]"}]], "+", 
         RowBox[{
          SqrtBox[
           SuperscriptBox["x", "2"]], " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["2", 
             RowBox[{"ep", "[", "x", "]"}]], "-", 
            FractionBox[
             RowBox[{"2", " ", "x", " ", 
              RowBox[{
               SuperscriptBox["ep", "\[Prime]",
                MultilineFunction->None], "[", "x", "]"}]}], 
             SuperscriptBox[
              RowBox[{"ep", "[", "x", "]"}], "2"]]}], ")"}]}]}], ")"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            SuperscriptBox["x", "6"], " ", 
            RowBox[{"ep", "[", "x", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["x", "4"], "+", 
              RowBox[{
               SuperscriptBox["T", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["x", "2"]}]}], ")"}]}]}], ")"}], " ", 
            SuperscriptBox[
             RowBox[{"ep", "[", "x", "]"}], "3"]}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["x", "7"], " ", 
            RowBox[{
             SuperscriptBox["ep", "\[Prime]",
              MultilineFunction->None], "[", "x", "]"}]}]}], ")"}]}], 
        RowBox[{"2", " ", 
         SuperscriptBox["x", "4"], " ", 
         SqrtBox[
          SuperscriptBox["x", "2"]], " ", 
         SuperscriptBox[
          RowBox[{"ep", "[", "x", "]"}], "2"]}]]}], "==", "0"}], ",", 
     RowBox[{"ep", "[", "x", "]"}], ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Result", " ", "for", " ", 
      SuperscriptBox["E", "\[CurlyPhi]"], " ", "is"}], " ", "\[PlusMinus]"}], 
    ",", 
    RowBox[{
    "we", " ", "can", " ", "use", " ", "either", " ", "because", " ", "it", 
     " ", "will", " ", "eventually", " ", "be", " ", "squared", " ", "in", 
     " ", "the", " ", "next", " ", 
     RowBox[{"step", "."}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ep", "[", "x", "]"}], "\[Rule]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SqrtBox["3"], " ", 
          SuperscriptBox["x", "3"]}], 
