Cell[BoxData[{
 RowBox[{
  RowBox[{"dotEx", ":=", 
   RowBox[{
    RowBox[{"2", " ", "x", " ", 
     RowBox[{"kp", "[", "x", "]"}], " ", 
     RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], "+", 
    RowBox[{"2", " ", "x", " ", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "x", " ", 
        RowBox[{"kp", "[", "x", "]"}], " ", 
        RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], "+", 
       RowBox[{"2", " ", "x", " ", 
        RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}]}], "==", "0"}], ",", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Correct", " ", "equation", " ", "for", " ", 
     RowBox[{
      RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}], ".", " ", "note"}], " ", 
     "that", " ", "the", " ", "sign", " ", "of", " ", "the", " ", "shift", 
     " ", "vector", " ", "was", " ", "changed", " ", "from"}], " ", "-", " ", 
    "to", " ", "+", " ", 
    RowBox[{
    "to", " ", "be", " ", "consistent", " ", "with", " ", "conventions", " ", 
     "in", " ", "the", " ", "\"\<Maximally Slicing a Black Hole\>\"", " ", 
     RowBox[{"paper", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}], "\[Rule]", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"kp", "[", "x", "]"}]}], " ", 
    RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992523345320854*^9, 3.9925233458603525`*^9}, {
