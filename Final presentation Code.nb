 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "We", " ", "used", " ", "both", " ", "ours", " ", "and", " ", "the", " ", 
     "papers", " ", "value", " ", "for", " ", "K\[Phi]", " ", "to", " ", 
     "solve", " ", "for", " ", 
     SuperscriptBox["E", "\[Phi]"]}], ",", " ", 
    RowBox[{"by", " ", "plugging", " ", "in", " ", "K\[Phi]", " ", "in", " ", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"and", " ", "then", " ", "plugging", " ", "in", " ", 
     RowBox[{"\[ScriptCapitalN]n", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"and", " ", 
     SubscriptBox["K", "\[Phi]"], " ", "into", " ", "our", " ", "classical", 
     " ", "Hamiltonian"}], ",", " ", 
    RowBox[{
    "the", " ", "transformed", " ", "Hamiltonian", " ", "then", " ", 
     "becomes", " ", "a", " ", "differential", " ", "equation", " ", "for", 
     " ", 
     RowBox[{
      SuperscriptBox["E", "\[Phi]"], "."}]}]}], " ", "*)"}]}]}], "Input",
