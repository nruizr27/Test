Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"1", "st", " ", "using", " ", "the", " ", 
    RowBox[{"paper", "'"}], "s", " ", "value", " ", "of", " ", 
    SubscriptBox["K", "\[Phi]"]}], " ", "=", " ", 
   RowBox[{
    FractionBox["T", 
     SuperscriptBox["x", "2"]], "."}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.992526282812663*^9, 3.9925263134459486`*^9}, 
   3.992526382729952*^9, {3.9925264178810425`*^9, 
