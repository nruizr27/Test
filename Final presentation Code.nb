   RowBox[{
    RowBox[{"Moving", " ", "on", " ", "to", " ", "solving", " ", "for", " ", 
     SubscriptBox["K", "\[Phi]"], " ", "a", " ", "specific", " ", "spatial", 
     " ", "gauge", " ", "is", " ", "chosen", " ", "by", " ", "setting", " ", 
     "the", " ", "triad", " ", "component", " ", 
     SuperscriptBox["E", "x"]}], " ", "=", " ", 
    SuperscriptBox["x", "2"]}], ",", " ", 
   RowBox[{
   "making", " ", "the", " ", "angular", " ", "component", " ", "of", " ", 
    "our", " ", "metric", " ", "fixed", " ", "because", " ", "we", " ", 
    "have", " ", "a", " ", "spherically", " ", "symmetric", " ", "spacetime", 
    " ", "metric"}], ",", " ", 
   RowBox[{
   "making", " ", "it", " ", "similar", " ", "to", " ", "the", " ", 
    "Scwarzschild", " ", 
    RowBox[{"metric", "."}]}]}], "*)"}]], "Input",
