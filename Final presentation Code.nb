26c46774f830"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NewHammC", ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[ScriptCapitalN]", "[", "x", "]"}]}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["T", "2"], " ", 
        RowBox[{"ep", "[", "x", "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["x", "2"], ")"}], 
        RowBox[{"3", "/", "2"}]]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["T", "2"], 
           SuperscriptBox["x", "4"]]}], ")"}], " ", 
        RowBox[{"ep", "[", "x", "]"}]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         SuperscriptBox["x", "2"]]}]], "+", 
      RowBox[{
